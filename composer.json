{
  "name": "mrden/demonizer",
  "description": "Process demonize",
  "type": "library",
  "version": "1.0.1",
  "keywords": [
    "demonize",
    "demonizer",
    "process"
  ],
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "ext-intl": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-pcntl": "*",
    "ext-posix": "*",
    "mrden/forker": "2.0.x-dev"
  },
  "require-dev": {
    "phpunit/phpunit": "^9",
    "vimeo/psalm": "^5",
    "friendsofphp/php-cs-fixer": "^3"
  },
  "authors": [
    {
      "name": "Denis Kiselev",
      "email": "kiselevden911@yandex.ru"
    }
  ],
  "autoload": {
    "psr-4": {
      "Mrden\\Demonizer\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests"
    }
  },
  "config": {
    "sort-packages": true
  },
  "scripts": {
    "bump-dev": [
      "@composer bump --dev-only",
      "@composer bin all bump --dev-only"
    ],
    "fixcs": "php-cs-fixer fix --diff",
    "psalm": "psalm --show-info=true --no-diff --no-cache --error-level=INFO_LEVEL",
    "test": "phpunit"
  }
}
