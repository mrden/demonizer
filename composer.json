{
  "name": "mrden/demonizer",
  "description": "Process demonizer",
  "type": "library",
  "keywords": [
    "demonize",
    "demonizer",
    "process"
  ],
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "mrden/forker": "2.0.x-dev"
  },
  "require-dev": {
    "phpunit/phpunit": "^11",
    "vimeo/psalm": "^6",
    "friendsofphp/php-cs-fixer": "^3"
  },
  "authors": [
    {
      "name": "Denis Kiselev",
      "email": "kiselevden911@yandex.ru"
    }
  ],
  "autoload": {
    "psr-4": {
      "Mrden\\Demonizer\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests"
    }
  },
  "config": {
    "sort-packages": true
  },
  "scripts": {
    "fixcs": "php-cs-fixer fix --diff",
    "fixcs:changed": "php-cs-fixer fix --diff --config=.php-cs-fixer.dist.php $(git diff --name-only --diff-filter=ACM HEAD | grep '\\.php$' | paste -sd ' ' -)",
    "fixcs:staged": "php-cs-fixer fix --diff --config=.php-cs-fixer.dist.php $(git diff --cached --name-only --diff-filter=ACM | grep '\\.php$' | paste -sd ' ' -)",
    "psalm": "psalm --show-info=true --no-diff --no-cache --error-level=INFO_LEVEL",
    "test": "phpunit",
    "test:unit": "phpunit",
    "test:integration": "phpunit --configuration phpunit.integration.xml",
    "test:stress": "phpunit --group stress",
    "test:all": [
      "@test:unit",
      "@test:integration"
    ]
  }
}
